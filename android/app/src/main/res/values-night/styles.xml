<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts. The template left this on a
         plain white background, so the frame the screenshot pass grabs before
         Flutter paints its first frame was a white flash; it now carries the
         loader brand colour and the app icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window background behind the Flutter UI once the engine is up. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
